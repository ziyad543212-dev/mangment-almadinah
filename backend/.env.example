NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:3000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-8-characters
UPLOAD_DIR=C:\path\to\project-data\uploads
PG_POOL_MAX=10
PG_TRANSPORT=auto
ALLOW_DATABASE_RESTORE=false
LOCAL_PADDLE_OCR_URL=http://127.0.0.1:8765/ocr
LOCAL_PADDLE_OCR_TIMEOUT_MS=90000
PADDLE_OCR_DETECTOR=PP-OCRv5_mobile_det
PADDLE_OCR_MAX_PASSES=2
PADDLE_OCR_BUDGET_SECONDS=45
PADDLE_OCR_CPU_THREADS=4
OCR_MAX_CONCURRENT=1
# Full-page cloud passport OCR, selected explicitly by the user in the UI.
# Local mode never calls Gemini. Keep cloud disabled until the API project has active billing.
# Google unpaid-service terms prohibit personal information. This confirmation is
# operator-provided; an API key alone cannot verify the project's billing state.
GEMINI_OCR_ENABLED=false
GEMINI_OCR_PAID_PROJECT_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.6-flash
GEMINI_OCR_TIMEOUT_MS=45000
